# Light Keepers 本地開發環境設定
# 複製此檔案為 .env 並填寫實際值
# cp .env.example .env

# ===== 資料庫 =====
# docker-compose 會把 DB_HOST/DB_PORT/DB_USERNAME/DB_DATABASE 直接注入 backend container，
# 以下值是「不透過 compose、直接在本機跑 backend」時需要的設定。
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password_here
DB_DATABASE=lightkeepers

# 開發環境允許 TypeORM 自動同步 schema；production 一律硬性停用（改用 migration）
# SYNC_TABLES=false

# ===== JWT =====
JWT_SECRET=your_secure_jwt_secret_here

# ===== pgAdmin =====
PGADMIN_PASSWORD=your_secure_pgadmin_password_here

# ===== AI / API Keys (選填) =====
# GEMINI_API_KEY=your_gemini_api_key
