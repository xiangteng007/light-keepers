# Light Keepers 本地開發環境設定
# 複製此檔案為 .env 並填寫實際值
# cp .env.example .env

# ===== 資料庫 =====
# docker-compose 會把 DB_HOST/DB_PORT/DB_USERNAME/DB_DATABASE 直接注入 backend container，
# 以下值是「不透過 compose、直接在本機跑 backend」時需要的設定。
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password_here
DB_DATABASE=lightkeepers

# 開發環境允許 TypeORM 自動同步 schema；production 一律硬性停用（改用 migration）
# SYNC_TABLES=false

# ===== JWT =====
JWT_SECRET=your_secure_jwt_secret_here

# ===== pgAdmin =====
PGADMIN_PASSWORD=your_secure_pgadmin_password_here

# ===== AI / API Keys (選填) =====
# GEMINI_API_KEY=your_gemini_api_key

# ===== LLM Provider (M.2 / D12-D13) =====
# gemini = 只用雲端 Gemini（預設，與 M.2 之前行為相同）
# local  = 只用內網推論主機；失敗會明確報錯，不會偷偷改打 Gemini
# hybrid = 先打本地，工作站離線/逾時時自動降級到 Gemini 並記 warn
# LLM_PROVIDER=hybrid

# 內網 RTX 5090 工作站的 Ollama OpenAI-compatible endpoint
# LLM_BASE_URL=http://192.168.1.50:11434/v1
# LLM_MODEL=qwen2.5:32b-instruct
# Ollama 可留空；vLLM / LiteLLM 需要
# LLM_API_KEY=

# 探測工作站是否在線的逾時（毫秒）。工作站是桌機、不保證 24/7 在線，
# 這個值決定 hybrid 模式最多等多久才降級。
# LLM_CONNECT_TIMEOUT_MS=3000
# 實際生成的逾時（毫秒）
# LLM_TIMEOUT_MS=60000
# 可重試錯誤的重試次數
# LLM_MAX_RETRIES=1
# 探測結果快取時間（毫秒）：工作站關機時避免每個請求都付 3 秒探測成本
# LLM_HEALTH_CACHE_MS=30000
