# Light Keepers 本地開發環境設定
# 複製此檔案為 .env 並填寫實際值
# cp .env.example .env

# ===== 資料庫 =====
DB_PASSWORD=your_secure_db_password_here

# ===== JWT =====
JWT_SECRET=your_secure_jwt_secret_here

# ===== pgAdmin =====
PGADMIN_PASSWORD=your_secure_pgadmin_password_here

# ===== AI / API Keys (選填) =====
# GEMINI_API_KEY=your_gemini_api_key
