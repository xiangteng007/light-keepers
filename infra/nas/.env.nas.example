# =============================================================================
# Light Keepers - NAS 生產環境設定範本（INF-1 / Phase M）
#
# 使用方式：
#   cp infra/nas/.env.nas.example infra/nas/.env
#   chmod 600 infra/nas/.env
#   # 逐項填寫，所有 CHANGE_ME 都必須換掉才可上線
#
# 本檔只放「佔位值」，絕不可寫入真實憑證。
# infra/nas/.env 已被 .gitignore 排除，不會進版控。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 主機儲存路徑（ADM 上的實體路徑）
#
#   NVME_DATA_ROOT  → M.2 NVMe RAID 10 池：高 IOPS，放 DB 與 uploads（熱資料）
#   HDD_BACKUP_ROOT → 3.5" HDD RAID 6 池：大容量，放備份（冷資料）
#
#   ⚠ 兩者「必須」落在不同的儲存池，否則備份與資料同生共死，失去備份意義。
#   ⚠ 目錄需先在 ADM File Explorer / SSH 建好，並確認容器 UID 可寫。
# -----------------------------------------------------------------------------
NVME_DATA_ROOT=/volume2/docker/lightkeepers
HDD_BACKUP_ROOT=/volume1/backup/lightkeepers
# 前端 build 產物（web-dashboard/dist）在 NAS 上的落點
WEB_DIST_PATH=/volume2/docker/lightkeepers/web

# -----------------------------------------------------------------------------
# 2. 對外服務
# -----------------------------------------------------------------------------
TZ=Asia/Taipei
# Cloudflare Tunnel 對外網域（不含 https://）
PUBLIC_DOMAIN=lightkeepers.example.org
# 允許的前端來源，逗號分隔；至少要包含 https://${PUBLIC_DOMAIN}
CORS_ORIGIN=https://lightkeepers.example.org
# nginx 在 NAS 上的內網 port（ADM 已佔用 80/443/8000/8001，勿衝突）
NGINX_HTTP_PORT=8080

# Cloudflare Tunnel token（Zero Trust → Networks → Tunnels → 建立後複製）
# 格式為一長串 base64；持有此 token 等同持有對外入口，務必當作最高機密看待。
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_cloudflare_tunnel_token

# -----------------------------------------------------------------------------
# 3. 資料庫（PostGIS，資料落在 NVME_DATA_ROOT/pgdata）
# -----------------------------------------------------------------------------
DB_DATABASE=lightkeepers
DB_USERNAME=lightkeepers
# 產生方式：openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_db_password_min_32_chars

# -----------------------------------------------------------------------------
# 4. 應用秘密
# -----------------------------------------------------------------------------
# 產生方式：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_jwt_secret_openssl_rand_hex_32
JWT_OFFLINE_SECRET=CHANGE_ME_jwt_offline_secret_openssl_rand_hex_32
JWT_ISSUER=lightkeepers
JWT_AUDIENCE=lightkeepers-app
# 產生方式：openssl rand -hex 32（用於欄位級加密，換值會導致既有密文無法解開）
ENCRYPTION_KEY=CHANGE_ME_encryption_key_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# 5. 檔案儲存（NAS 上一律走 local driver；GCS 相關 env 全部留空即可）
#
#   STORAGE_PROVIDER=local  → StorageModule 選用 LocalStorageProvider
#   LOCAL_STORAGE_PATH      → 容器內路徑，對應 host 的 ${NVME_DATA_ROOT}/uploads
#   LOCAL_STORAGE_URL       → 對外可讀的 URL；由 nginx 的 /uploads/ location 提供
#   UPLOAD_DIR / BASE_URL   → FileStorageService（另一條舊路徑）使用的同義設定
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/app/uploads
LOCAL_STORAGE_URL=https://lightkeepers.example.org/uploads
UPLOAD_DIR=/app/uploads
BASE_URL=https://lightkeepers.example.org
FRONTEND_URL=https://lightkeepers.example.org

# -----------------------------------------------------------------------------
# 6. 本地 LLM（RTX 5090 工作站，OpenAI-compatible endpoint）
#
#   工作站需執行：OLLAMA_HOST=0.0.0.0:11434 ollama serve
#   NAS 與工作站同內網 2.5GbE；建議在工作站給固定 IP 或 DHCP 保留。
#   ⚠ 11434 只綁內網介面，不可經 Tunnel 或 port forward 對外曝露。
#   ⚠ 實際的 provider 接線屬工作項 M.2；此處先把組態面備妥。
# -----------------------------------------------------------------------------
WORKSTATION_IP=192.168.1.50
LLM_BASE_URL=http://192.168.1.50:11434/v1
LLM_MODEL=qwen2.5:32b-instruct
# Ollama 不驗證此值，但 OpenAI-compatible client 需要非空字串
LLM_API_KEY=ollama
# 工作站離線時的雲端 fallback（依 D13 混合策略決定是否啟用，可留空）
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# 7. 備份策略（寫入 HDD RAID 6 池）
# -----------------------------------------------------------------------------
# 每日執行時間（24h 制，容器內時區 = TZ）
BACKUP_AT=03:30
# 保留天數：超過的 dump 與 uploads 快照會被清掉
BACKUP_RETENTION_DAYS=14

# -----------------------------------------------------------------------------
# 8. 外部服務（不受 GCP 租約影響，搬遷後沿用；未使用者留空）
#
#   ⚠ LINE webhook URL 需在 LINE Developers Console 改指到
#     https://${PUBLIC_DOMAIN}/api/v1/line-bot/webhook（實際路徑見 backend 路由）
# -----------------------------------------------------------------------------
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
LINE_REDIRECT_URI=
LIFF_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_MAPS_API_KEY=

# FCM 推播（Firebase service account JSON，單行）
FIREBASE_SERVICE_ACCOUNT=
FCM_SERVER_KEY=

# 資料來源 API
CWA_API_KEY=
WRA_API_KEY=

# 本地錯誤追蹤（取代 Cloud Error Reporting；自架或免費額度）
SENTRY_DSN=

# -----------------------------------------------------------------------------
# 9. 映像檔標籤
#
#   在 NAS 上直接 build（N5105 較慢，約 10–20 分鐘），或由 CI 推到 registry 再拉。
# -----------------------------------------------------------------------------
BACKEND_IMAGE=lightkeepers/backend:local

# -----------------------------------------------------------------------------
# 10. 搬遷腳本用（僅在 M.3/M.4 一次性搬遷期間需要，搬完即可刪除）
#
#   ⚠ 這些是「來源端」憑證，只在搬遷當下填，搬完務必清空。
#   ⚠ 絕不可把 service account 金鑰 JSON 內容貼進本檔；用 GOOGLE_APPLICATION_
#     CREDENTIALS 指向檔案路徑，並確保該檔權限 600。
# -----------------------------------------------------------------------------
# Cloud SQL 來源（透過 cloud-sql-proxy 打到 127.0.0.1 時 host 填 127.0.0.1）
SRC_DB_HOST=
SRC_DB_PORT=5432
SRC_DB_USERNAME=
SRC_DB_PASSWORD=
SRC_DB_DATABASE=
# GCS 來源 bucket（對應 backend 的 GCS_BUCKET / GCS_BUCKET_NAME / GCS_MAP_PACKAGES_BUCKET）
SRC_GCS_BUCKETS=
GOOGLE_APPLICATION_CREDENTIALS=
